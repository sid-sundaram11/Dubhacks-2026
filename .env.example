# Node server (port 8787). Never prefix with EXPO_PUBLIC_.
SAM3_URL=http://127.0.0.1:8790
# Optional. React Native requests often omit Origin; when Origin is present it must match.
ALLOWED_ORIGIN=

# Expo client — Firebase web app config (Anonymous Auth + Firestore). See docs/realtime-demo.md.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Physical iPhone demos: Mac LAN IP for the Node API (simulator may use 127.0.0.1).
EXPO_PUBLIC_API_BASE=

# Orbit API. Server-only. Never prefix these with EXPO_PUBLIC_.
# Leave Supabase blank to use the local memory store and dev anonymous tokens.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
ORBIT_DEV_JWT_SECRET=dev-orbit-secret
ORBIT_STORE_PATH=data/orbit-store.json

# Weekly comet. Missing key stores the fallback image instead of calling Grok Imagine.
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-2-image
