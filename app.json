{
  "expo": {
    "name": "Constellations",
    "slug": "ai-constellation-creator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Constellations connects to the Mac on your Wi‑Fi network that runs the constellation generator.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSMotionUsageDescription": "Constellations uses device motion to move the star sky as you turn your phone."
      },
      "bundleIdentifier": "com.angadslr.ai-constellation-creator"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Constellations uses photos to draw a constellation from the subject.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Constellations uses device motion to move the star sky as you turn your phone."
        }
      ]
    ]
  }
}
